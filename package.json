{
  "name": "class-gift",
  "productName": "CLASS GIFT Agent Workspace",
  "version": "0.1.1",
  "description": "Medicare agent desktop workspace",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^35.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.chappleworks.classgift",
    "productName": "CLASS GIFT Agent Workspace",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}